diff --git a/hardware/src/MIPS32/Cache/DCache/DataCache_2KB.v b/hardware/src/MIPS32/Cache/DCache/DataCache_2KB.v
index 0000000..0000000 100644
--- a/hardware/src/MIPS32/Cache/DCache/DataCache_2KB.v
+++ b/hardware/src/MIPS32/Cache/DCache/DataCache_2KB.v
@@ -34,6 +34,7 @@ module DataCache_2KB #(parameter PABITS=36) (
     output                 WordOutReady_M,  // The cache write buffer is non-empty and 'DataOut_M[31:0]' is valid.
     output [3:0]           WordOutBE_M,      // Byte enable bits for single-word memory writes (using 'WordOutReady_M').
+    output                 WordOutPAddressValid_M, // PAddressValid captured with this queued word transaction.
     output [127:0]         DataOut_M,        // Writeback data from the cache to memory. Full cacheline ([127:0]) or uncacheable word ([31:0]).
@@ -73,7 +74,8 @@ module DataCache_2KB #(parameter PABITS=36) (
     wire [5:0]  r_index;               // Request index
     wire [1:0]  r_offset;              // Request offset
     wire [(PABITS-11):0] s_tag;        // TLB-translated physical tag, up to 24 (+2 for 2KB cache) bits of a 36-bit physical address
-    wire        s_uncacheable;         // The service address is in the uncacheable range
+    reg         s_uncacheable;         // Latched cache attribute for the service request
+    reg         s_paddr_valid;         // Latched physical-address-valid for the service request
@@ -115,7 +117,7 @@ module DataCache_2KB #(parameter PABITS=36) (
     wire WB_Empty;
     wire WB_Full;
-    reg  [((PABITS-5)+129):0] WB_DataIn;    // {32-bit line addr, 128-bit line, 1-bit cacheable} OR
+    reg  [((PABITS-5)+130):0] WB_DataIn;    // {word address, payload, uncacheable/type, queued PAddressValid} OR
     wire [((PABITS-5)+130):0] WB_DataOut;   // Adds queued PAddressValid above the existing payload/type fields
@@ -135,6 +137,7 @@ module DataCache_2KB #(parameter PABITS=36) (
     assign LineOutReady_M = ~WB_Empty &  WB_DataOut[0];
     assign WordOutReady_M = ~WB_Empty & ~WB_DataOut[0];
     assign WordOutBE_M    = WB_DataOut[36:33];
+    assign WordOutPAddressValid_M = WB_DataOut[((PABITS-5)+130)];
     assign DataOut_M      = WB_DataOut[128:1];
@@ -206,7 +209,7 @@ module DataCache_2KB #(parameter PABITS=36) (
-    assign s_uncacheable    = (CacheAttr_C == 3'b010);
     assign s_write_any      = (s_write != 4'b0000);
@@ -280,6 +282,18 @@ module DataCache_2KB #(parameter PABITS=36) (
     DFF_E #(.WIDTH(1)) ff_using_delay_data (.clock(clock), .enable(1'b1),          .D(delay_update),     .Q(using_delay_data));
 
+    // Keep qualification aligned with the service request, not live processor
+    // sidebands that may change while a queued write waits for Ready_M.
+    always @(posedge clock) begin
+        if (reset) begin
+            s_uncacheable <= 1'b0;
+            s_paddr_valid <= 1'b0;
+        end
+        else if (new_request) begin
+            s_uncacheable <= (CacheAttr_C == 3'b010);
+            s_paddr_valid <= PAddressValid_C;
+        end
+    end
+
@@ -323,6 +337,7 @@ module DataCache_2KB #(parameter PABITS=36) (
     // {la[160:129], line[128:1], cached[0]} OR
     // {wa[160:127], X[126:37], we[36:33], data[32:1], cached[0]}
     always @(*) begin
+        WB_DataIn[((PABITS-5)+130)] <= s_paddr_valid;
         // {la[160:129], line[128:1], 128-bit line, 1-bit cacheable} OR
@@ -493,7 +508,7 @@ module DataCache_2KB #(parameter PABITS=36) (
     FIFO #(
-        .DATA_WIDTH  (((PABITS-5)+129+1)),
+        .DATA_WIDTH  (((PABITS-5)+130+1)),
         .ADDR_WIDTH  (2))
